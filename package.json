{
  "name": "github-copilot-comment-browser-extension",
  "description": "Add one-click IDE actions to GitHub pull request Copilot comments that open VS Code or Cursor with a prepared prompt",
  "private": true,
  "version": "0.0.5",
  "type": "module",
  "packageManager": "pnpm@11.29.0",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "lint": "biome check",
    "type:check": "tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@wxt-dev/storage": "1.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-feather": "2.0.10"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@tailwindcss/postcss": "4.3.5",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@wxt-dev/module-react": "1.2.2",
    "autoprefixer": "10.7.0",
    "postcss": "8.5.33",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "wxt": "0.21.5"
  }
}
